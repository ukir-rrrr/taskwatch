# Devin API (v3)。未設定の場合はダミーデータで動作します。
# .env.local にコピーして値を設定してください（.env.local はコミットしないこと）。
DEVIN_API_KEY=
DEVIN_ORG_ID=

# 任意: DBファイルの場所（既定: data/taskwatch.db）
# TASKWATCH_DB_PATH=data/taskwatch.db

# 任意: Turso（libSQL）を使う場合は両方を設定（片方だけならローカル SQLite を使う）
# TURSO_DATABASE_URL=libsql://<db名>-<組織名>.turso.io
# TURSO_AUTH_TOKEN=
